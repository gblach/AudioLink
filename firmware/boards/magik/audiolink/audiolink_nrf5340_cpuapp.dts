/dts-v1/;
#include <nordic/nrf5340_cpuapp_qkaa.dtsi>
#include <zephyr/dt-bindings/led/led.h>
#include "audiolink_nrf5340_cpuapp-pinctrl.dtsi"

/ {
	model = "AudioLink nRF5340 Application";
	compatible = "magik,audiolink-nrf5340-cpuapp";

	chosen {
		zephyr,sram = &sram0_image;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,sram-secure-partition = &sram0_s;
		zephyr,sram-non-secure-partition = &sram0_ns;
		zephyr,bt-hci = &bt_hci_ipc0;
		zephyr,boot-mode = &boot_mode0;
	};

	/*
	 * J1/J2 detect: the NRJ6HM-1 sleeve-normal contact shorts SN to the grounded
	 * sleeve until a plug is inserted, after which R12/R13 pull it high.
	 */
	analog: analog {
		compatible = "magik,audiolink-analog";
		power-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
		mute-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
		mode-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
		j1-det-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
		j2-det-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
	};

	aliases {
		led-strip = &led_strip;
	};
};

&vregmain {
	regulator-initial-mode = <NRF5X_REG_MODE_LDO>;
};

&vregradio {
	regulator-initial-mode = <NRF5X_REG_MODE_LDO>;
};

/* VDDH is tied to VDD, so the high voltage regulator is not used. */
&vregh {
	status = "disabled";
};

/* Y1 has its own 7 pF load capacitors (C15/C16). */
&lfxo {
	load-capacitors = "external";
};

&clock {
	hfclkaudio-frequency = <12288000>;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&i2c1 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";

	/* ADR1 and ADR2 strapped low */
	pcm5242: pcm5242@4c {
		compatible = "ti,pcm5242";
		reg = <0x4c>;
	};
};

&i2s0 {
	status = "okay";
	pinctrl-0 = <&i2s0_default>;
	pinctrl-1 = <&i2s0_sleep>;
	pinctrl-names = "default", "sleep";
	clock-source = "ACLK";
};

/*
 * At 4 MHz one SPI bit is 250 ns, so each WS2812 bit is sent as a 4-bit symbol:
 * 0b1000 = 0.25 us high (zero), 0b1110 = 0.75 us high (one).
 */
&spi2 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		spi-max-frequency = <4000000>;
		chain-length = <4>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
	};
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";
};

/*
 * No external flash, so the network core update is staged in slot3 next to the
 * two application slots.
 */
&flash0 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(64)>;
		};

		slot0_partition: partition@10000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00010000 DT_SIZE_K(352)>;
		};

		slot1_partition: partition@68000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00068000 DT_SIZE_K(352)>;
		};

		slot3_partition: partition@c0000 {
			compatible = "zephyr,mapped-partition";
			label = "image-3";
			reg = <0x000c0000 DT_SIZE_K(224)>;
		};

		storage_partition: partition@f8000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x000f8000 DT_SIZE_K(32)>;
		};
	};
};

/* Survives a soft reset, so the application can tell MCUboot to stay in USB recovery mode */
&gpregret1 {
	status = "okay";

	boot_mode0: boot_mode@0 {
		compatible = "zephyr,retention";
		status = "okay";
		reg = <0x0 0x1>;
	};
};

&uicr {
	bl_storage: uicr@100 {
		reg = <0x100 0x280>;
	};
};

#include <nordic/nrf5340_sram_partition.dtsi>
#include <nordic/nrf5340_shared_sram_partition.dtsi>
